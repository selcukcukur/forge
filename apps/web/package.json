{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev"               : "next dev --hostname selcukcukur.dev --experimental-https --experimental-https-key ./certificate/selcukcukur-key.pem --experimental-https-cert ./certificate/selcukcukur.pem --turbopack --port 443",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "catalog:base",
    "react": "catalog:base",
    "react-dom" : "catalog:base"
  },
  "devDependencies": {
    "@selcukcukur/presets": "workspace:*",
    "@types/node": "catalog:type",
    "@types/react": "catalog:type",
    "@types/react-dom": "catalog:type",
    "typescript": "catalog:base"
  }
}
