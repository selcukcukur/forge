{
  "private"           : true,
  "name"              : "forge",
  "description"       : "My digital workshop — a living lab for ideas, experiments, and open-source creations.",
  "keywords"          : ["react","open-source","laboratory","playground","typescript","creative-coding","nextjs","innovation","ideas","exploration","experiments","prototypes","personal-projects","tailwindcss","radix-ui"],
  "license"           : "MIT",
  "homepage"          : "https://selcukcukur.me",
  "version"           : "0.0.1",

  "author"            : {
    "name"  : "Selçuk Çukur",
    "email" : "hello@selcukcukur.me",
