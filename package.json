  },

  "bugs"              : {
    "email" : "security@selcukcukur.me",
    "url"   : "https://github.com/selcukcukur/forge/issues"
  },

  "scripts"           : {
    "build"             : "next build",
    "dev"               : "next dev --hostname selcukcukur.dev --experimental-https --experimental-https-key ./certificate/selcukcukur-key.pem --experimental-https-cert ./certificate/selcukcukur.pem --turbopack --port 443",
    "clean"             : "rimraf node_modules dist .next .turbo",
    "lint"              : "next lint",
    "start"             : "next server",
    "test"              : "vitest -no-file-parallelism --bail=1",
    "script"            : "tsx ./scripts/run.ts"
  },

  "dependencies"      : {
    "@workspace/interface"    : "workspace:*",
    "@obvia/utilities"        : "^1.0.3",
    "@vercel/analytics"       : "^2.0.1",
    "next"                    : "catalog:base",
    "react"                   : "catalog:base",
    "react-dom"               : "catalog:base",
    "fumadocs-core"           : "^16.8.12",
    "fumadocs-mdx"            : "^15.0.7",
    "swr"                     : "^2.4.1",
    "lucide-react"            : "^0.577.0",
    "jotai"                   : "^2.18.1",
    "zod"                     : "^4"
  },
  "devDependencies"   : {
    "@obvia/presets"                    : "^0.0.2",
    "@types/node"             : "catalog:type",
    "@types/react"            : "catalog:type",
    "@types/react-dom"        : "catalog:type",
    "@types/mdx"              : "^2.0.13",
    "eslint"                            : "^10.1.0",
    "prettier"                          : "^3.8.1",
    "prettier-plugin-organize-imports"  : "^4.3.0",
    "prettier-plugin-tailwindcss"       : "^0.7.2",
    "turbo"                             : "^2.8.20",
    "typescript"                        : "catalog:base",
    "rimraf"                            : "^6.1.3"
  },

  "packageManager"    : "pnpm@10.32.1",
  "engines"           : {
    "node"  : ">=24"
  }
