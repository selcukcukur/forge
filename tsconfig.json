{
  "extends"         : "@obvia/presets/next-config",
  "compilerOptions" : {
    "declaration" : false,
    "baseUrl"     : ".",
    "paths"       : {
      "@/*"            : ["*"],
      "@action"        : ["./library/action/index.ts"],
      "@action/*"      : ["./library/action/*"],
      "@collections/*" : ["./.source/*"],
      "@config"        : ["./config/index.ts"],
      "@config/*"      : ["./config/*"],
      "@hooks"         : ["./hooks/index.ts"],
      "@hooks/*"       : ["./hooks/*"],
      "@interface/*"   : ["./interface/*"],
      "@library/*"     : ["./library/*"],
      "@query"         : ["./library/query/index.ts"],
      "@query/*"       : ["./library/query/*"],
      "@schema/*"      : ["./library/schema/*"],
      "@server"        : ["./library/server/index.ts"],
      "@server/*"      : ["./library/server/*"],
      "@scripts"       : ["./scripts/index.ts"],
      "@scripts/*"     : ["./scripts/*"],
      "@styles/*"      : ["./styles/*"]
    }
  },
  "include"         : ["**/*.ts", "**/*.tsx", "**/*.d.ts",
    "../../next-env.d.ts",
    "../../next.config.ts", ".next/types/**/*.ts"],
  "exclude"         : ["dist", "build", "node_modules"]
}
